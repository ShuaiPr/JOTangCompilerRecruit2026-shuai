{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "cmake-build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--parallel"],
      "dependsOn": ["cmake-configure"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run-compiler",
      "type": "shell",
      "command": "${workspaceFolder}/build/compiler_middle_end",
      "args": [
        "${workspaceFolder}/input.sy",
        "-S",
        "-o",
        "${workspaceFolder}/output.ll",
        "-O1"
      ],
      "dependsOn": ["cmake-build"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "run-test-middle-end",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/test_middle_end.py",
        "--compiler",
        "${workspaceFolder}/build/compiler_middle_end"
      ],
      "dependsOn": ["cmake-build"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "/home/shuai/opt/llvm-21/usr/bin:${env:PATH}" }
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
